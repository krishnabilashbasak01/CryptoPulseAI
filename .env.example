# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# KIE_API_KEY: Optional Kie.ai subscription API key for automated AI trading signals (https://docs.kie.ai/).
# Configure in AI Studio Settings > Secrets.
KIE_API_KEY="MY_KIE_API_KEY"

# KIE_API_MODEL: Optional Kie.ai model identifier (defaults to gpt-5-2).
KIE_API_MODEL="gpt-5-2"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
